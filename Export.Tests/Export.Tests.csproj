      <IncludeAssets>runtime;native;libs;buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Export\Export.csproj" />
  </ItemGroup>
</Project>
